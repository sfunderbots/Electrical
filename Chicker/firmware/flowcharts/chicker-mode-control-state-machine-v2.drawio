        <mxCell id="v2-33" value="every 25 ms: HV adjustment -&amp;gt; set duty&lt;div&gt;D = D0 * V_start / V (hold force),&lt;/div&gt;&lt;div&gt;capped by gain 2x, max duty, power limit&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="1060" width="300" height="60" as="geometry" /></mxCell>
