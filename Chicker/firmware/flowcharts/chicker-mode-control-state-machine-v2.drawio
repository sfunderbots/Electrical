        <mxCell id="v2-31" value="Initial Kick&lt;div&gt;(800 us)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1060" y="960" width="120" height="70" as="geometry" /></mxCell>
