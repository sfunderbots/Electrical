<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="chicker-v2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2-1" value="" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="1180" as="geometry" /></mxCell>
        <mxCell id="v2-2" value='&lt;b&gt;&lt;font style="font-size: 24px;"&gt;Chicker Mode Control State Machine (v2)&lt;/font&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="410" y="30" width="660" height="34" as="geometry" /></mxCell>
        <mxCell id="v2-3" value="&lt;b&gt;Owns:&lt;/b&gt; what the board is doing for the robot. &lt;b&gt;Never&lt;/b&gt; writes charge-machine or power-stage variables - it outputs &lt;i&gt;charge allowed&lt;/i&gt;, &lt;i&gt;dump bank&lt;/i&gt;, kicker requests and events; app.py passes them on.&lt;br&gt;&lt;b&gt;Commands&lt;/b&gt; (CAN protocol v2, or USB console - same decoder): MODE (IDLE / CHARGE), KICK (width, trigger beam / now, arm time), DAMP (freq, duty 0.01 %, hold, initial kick), HEARTBEAT 20 Hz. Legacy 0x2AA frames still accepted.&lt;br&gt;&lt;b&gt;Kicks fire at any time&lt;/b&gt;: charging is stopped first (5 ms quiet), never overlapping a charge cycle. Board boots Idle and only charges when commanded." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1360" height="75" as="geometry" /></mxCell>
        <mxCell id="v2-4" value="ANY STATE" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="90" height="40" as="geometry" /></mxCell>
        <mxCell id="v2-5" value="ANY STATE" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="90" height="40" as="geometry" /></mxCell>
        <mxCell id="v2-6" value="ANY STATE" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="90" height="40" as="geometry" /></mxCell>
        <mxCell id="v2-7" value="Idle&lt;div&gt;(no charging,&lt;/div&gt;&lt;div&gt;bank dumped,&lt;/div&gt;&lt;div&gt;kicker off)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="155" width="120" height="90" as="geometry" /></mxCell>
        <mxCell id="v2-8" value="Fault (latched)&lt;div&gt;bank dumped,&lt;/div&gt;&lt;div&gt;report to Pi&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="v2-9" value="abort kicker&lt;div&gt;stop PWM&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="165" width="100" height="60" as="geometry" /></mxCell>
        <mxCell id="v2-10" value="Wait for&lt;div&gt;Command&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-11" value="Parse&lt;div&gt;(protocol.py)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="430" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-12" value="Rejected&lt;div&gt;EVENT to Pi&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="250" y="540" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-13" value="Command&lt;div&gt;Received&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="430" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-14" value="Ready&lt;div&gt;(charging allowed)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="v2-15" value='&lt;font color="#CC0000"&gt;KICK / DAMP in Idle -&amp;gt; rejected&lt;br&gt;(send MODE CHARGE first).&lt;br&gt;Anything but MODE IDLE in Fault -&amp;gt; rejected.&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="625" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="v2-16" value="Kick Armed&lt;div&gt;(charging allowed)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="650" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="v2-17" value="Kick Prep&lt;div&gt;(charging stopped)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="120" height="70" as="geometry" /></mxCell>
        <mxCell id="v2-18" value="GUARD" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="180" height="108" as="geometry" /></mxCell>
        <mxCell id="v2-19" value="50 us &amp;lt;= PW &amp;lt;= 5000 us" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-18"><mxGeometry x="0" y="30" width="180" height="26" as="geometry" /></mxCell>
        <mxCell id="v2-20" value="CHARGE low &amp;gt;= 5 ms" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-18"><mxGeometry x="0" y="56" width="180" height="26" as="geometry" /></mxCell>
        <mxCell id="v2-21" value="kicker idle" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-18"><mxGeometry x="0" y="82" width="180" height="26" as="geometry" /></mxCell>
