        <mxCell id="v2-23" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FF3333;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="560" height="150" as="geometry" /></mxCell>
        <mxCell id="v2-24" value="Break-beam Mini State Machine (hard IRQ)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="260" height="30" as="geometry" /></mxCell>
        <mxCell id="v2-25" value="Beam broken&lt;div&gt;(falling edge)&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="620" y="820" width="100" height="60" as="geometry" /></mxCell>
        <mxCell id="v2-26" value="fast_ok?&lt;div&gt;(armed, CHARGE low&lt;/div&gt;&lt;div&gt;&gt;= 5 ms, kicker idle)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="770" y="810" width="130" height="80" as="geometry" /></mxCell>
        <mxCell id="v2-27" value="Fire pre-validated&lt;div&gt;kick on the PIO&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="950" y="810" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="v2-28" value="no: main loop&lt;div&gt;takes the beam&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="760" y="890" width="150" height="30" as="geometry" /></mxCell>
        <mxCell id="v2-29" value="Damp Wait HV&lt;div&gt;(charging allowed)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="960" width="120" height="70" as="geometry" /></mxCell>
