<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="chicker-v2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v2-1" value="" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="980" as="geometry" /></mxCell>
        <mxCell id="v2-2" value='&lt;b&gt;&lt;font style="font-size: 24px;"&gt;Chicker Charge State Machine (v2)&lt;/font&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="380" y="30" width="660" height="34" as="geometry" /></mxCell>
        <mxCell id="v2-3" value="&lt;b&gt;Owns:&lt;/b&gt; the decision to run the LT3750. &lt;b&gt;Output:&lt;/b&gt; &amp;quot;want CHARGE high&amp;quot; - the power stage only raises it once ~DISCHARGE has been released for 50 ms.&lt;br&gt;&lt;b&gt;Inputs (read-only, passed in by app.py):&lt;/b&gt; allow = mode machine allows charging AND kicker idle AND &amp;gt;= 100 ms since the last kick &amp;nbsp;|&amp;nbsp; battery OK (debounced, 14.7 V on / 14.3 V off) &amp;nbsp;|&amp;nbsp; DONE (high = switching) &amp;nbsp;|&amp;nbsp; HV (ADC) &amp;nbsp;|&amp;nbsp; bench ceiling.&lt;br&gt;Charging is driven by the &lt;b&gt;HV measurement&lt;/b&gt;: top off below 205 V, stop at a ceiling, check HV really rises and that DONE falls at a plausible voltage. Timers are only backstops. &lt;b&gt;CHARGE is LOW in every state except Starting / Charging.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1300" height="70" as="geometry" /></mxCell>
        <mxCell id="v2-4" value="ANY STATE" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="90" height="40" as="geometry" /></mxCell>
        <mxCell id="v2-5" value="No Battery" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="230" y="153" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-6" value="Battery Settle&lt;div&gt;(wait 2 s)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="470" y="153" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-7" value="ANY STATE" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="90" height="40" as="geometry" /></mxCell>
        <mxCell id="v2-8" value="Inhibited&lt;div&gt;(CHARGE low)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="470" y="253" width="100" height="64" as="geometry" /></mxCell>
        <mxCell id="v2-9" value="Charge Toggle&lt;div&gt;Reset (Gap)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="110" height="70" as="geometry" /></mxCell>
        <mxCell id="v2-10" value="GUARD" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="495" width="230" height="108" as="geometry" /></mxCell>
        <mxCell id="v2-11" value="CHARGE low &amp;gt;= 50 ms" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-10"><mxGeometry x="0" y="30" width="230" height="26" as="geometry" /></mxCell>
        <mxCell id="v2-12" value="~DISCHARGE released &amp;gt;= 50 ms" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-10"><mxGeometry x="0" y="56" width="230" height="26" as="geometry" /></mxCell>
        <mxCell id="v2-13" value="&amp;gt;= 500 ms since last cycle start" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="v2-10"><mxGeometry x="0" y="82" width="230" height="26" as="geometry" /></mxCell>
        <mxCell id="v2-14" value="Starting&lt;div&gt;(CHARGE high)&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="690" y="520" width="110" height="70" as="geometry" /></mxCell>
